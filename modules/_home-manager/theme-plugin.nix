# Home Manager module: a theme-only Logseq plugin generated from a palette.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  inherit (lib) mkOption types;

  cfg = config.programs.logseq.themePlugin;
  theme = import ../../lib/logseq-theme.nix { inherit lib; };

  hexColor = types.strMatching "#[0-9a-fA-F]{6}";

  colorOptions =
    defaults: descriptions:
    lib.mapAttrs (
      name: description:
      mkOption {
        type = hexColor;
        default = defaults.${name};
        inherit description;
      }
    ) descriptions;

  toneOptions = lib.mapAttrs (
    _: description:
    mkOption {
      type = types.nullOr hexColor;
      default = null;
      defaultText = lib.literalMD "derived from `accent`, `background`, and `bright`";
      inherit description;
    }
  );

  packageJson = {
    inherit (cfg) name description;
    version = "0.0.1";
    logseq = {
      id = cfg.name;
      inherit (cfg) title;
      themes = [
        {
          name = cfg.title;
          url = "./theme.css";
          inherit (cfg) description;
          mode = "dark";
        }
      ];
    };
  };

  plugin =
    pkgs.runCommand "logseq-theme-plugin-${cfg.name}"
      {
        passAsFile = [
          "css"
          "packageJson"
        ];
        css = theme.render { inherit (cfg) colors extraCss; };
        packageJson = builtins.toJSON packageJson;
        meta = {
          description = "Logseq theme plugin ${cfg.title}";
          platforms = lib.platforms.all;
        };
      }
      ''
        mkdir "$out"
        cp "$cssPath" "$out/theme.css"
        cp "$packageJsonPath" "$out/package.json"
      '';
in
{
  options.programs.logseq.themePlugin = {
    enable = lib.mkEnableOption "a generated dark Logseq theme plugin under ~/.logseq/plugins";

    name = mkOption {
      type = types.strMatching "[A-Za-z0-9][A-Za-z0-9._-]*";
      default = "nix-theme";
      description = ''
        Directory under `~/.logseq/plugins` and the plugin id. Logseq stores
        the selected theme by this id, so renaming it requires selecting the
        theme again in the theme picker (`t i`).
      '';
    };

    title = mkOption {
      type = types.str;
      default = "Nix Theme";
      description = "Theme name shown in the theme picker.";
    };

    description = mkOption {
      type = types.str;
      default = "Dark theme generated by Home Manager";
      description = "Plugin and theme description shown in the plugin list.";
    };

    colors = mkOption {
      description = ''
        Semantic palette as `#rrggbb` strings. The twelve neutral steps
        `background` through `text` form Logseq's gray scale in order, from
        the app background to high-contrast text, so a palette that replaces
        them sets all twelve. The defaults are VS Code Dark 2026 greys over
        GitHub Dark syntax colours. The accent tones `highlight`,
        `selection`, `link`, and `linkHover` default to null: the shipped
        `accent`, `background`, and `bright` keep tuned tones, and any other
        combination blends them from `accent`.
      '';
      default = { };
      type = types.submodule {
        options =
          colorOptions theme.defaultColors {
            background = "Gray step 1: page background and cards.";
            sidebar = "Gray step 2: the top bar, both sidebars, and dialogs; code blocks, quotes, alternate table rows.";
            popup = "Gray step 3: popovers and menus, block and page properties, table headers, the active code line.";
            border = "Gray step 4: borders, the edges between the top bar, sidebars, and content, right-sidebar card outlines, input outlines, block guide lines.";
            activeItem = "Gray step 5: secondary buttons, selected table rows.";
            raised = "Gray step 6: inline code background, command palette and theme picker highlights, keyboard-shortcut keys.";
            strongBorder = "Gray step 7: keyboard-key and classic form-input borders.";
            bullet = "Gray step 8: block bullets and the shortcut toolbar text.";
            subtle = "Gray step 9: checkboxes and radio buttons, quote borders, scrollbar thumbs, matching-bracket outlines in code.";
            dim = "Gray step 10: code line numbers and the hovered block guide line.";
            muted = "Gray step 11: secondary text, icons, input placeholders.";
            text = "Gray step 12: body text, including selected text and inline code.";
            bright = "Accent step 12: marked text, hovered plain links, matching brackets in code, the text of active sidebar and settings items, and the 8% hover and 13% active overlays on those lists.";
            onAccent = "Text on primary, accent, and destructive fills and on the keyboard-selected command palette row.";
            accent = "Fills, focus rings, the outline and 15% tint of highlighted menu items, accent steps 8-9. A darker tone (accent step 7) fills primary buttons and the keyboard-selected command palette row.";
            danger = "Destructive buttons and text.";
            mark = "Background of marked text, applied at 40% opacity.";
            cloze = "Cloze text.";
          }
          // toneOptions {
            highlight = "Highlighted and selected blocks and table cells (accent step 3); blended with `selection` into step 4, hovered page references.";
            selection = "Text selection background, in code too, and hovered page property keys (accent step 5).";
            link = "Links, page references, tags (accent steps 10-11).";
            linkHover = "Hovered block references and property links, link underlines on hover.";
          }
          // {
            syntax = mkOption {
              description = "CodeMirror code block token colours.";
              default = { };
              type = types.submodule {
                options = colorOptions theme.defaultColors.syntax {
                  keyword = "Keywords and operators.";
                  constant = "Numbers, atoms, properties, attributes.";
                  function = "Definitions.";
                  variable = "Variables.";
                  parameter = "Secondary variables such as parameters.";
                  type = "Types and builtins.";
                  string = "Strings and links.";
                  regexp = "Regular expressions and secondary strings.";
                  comment = "Comments.";
                  tag = "Markup tags.";
                  heading = "Markup headings.";
                  invalid = "Errors and unmatched brackets.";
                };
              };
            };
          };
      };
    };

    extraCss = mkOption {
      type = types.lines;
      default = "";
      description = "CSS appended to the generated theme.css.";
    };

    package = mkOption {
      type = types.package;
      readOnly = true;
      default = plugin;
      defaultText = lib.literalMD "a directory holding the generated `package.json` and `theme.css`";
      description = "The generated plugin directory.";
    };
  };

  config = lib.mkIf cfg.enable {
    # One link per file: Home Manager then creates the plugin folder as a real
    # directory, and Logseq skips symlinked entries when it lists
    # ~/.logseq/plugins (electron/utils.cljs get-ls-default-plugins).
    home.file = {
      ".logseq/plugins/${cfg.name}/package.json".source = "${cfg.package}/package.json";
      ".logseq/plugins/${cfg.name}/theme.css".source = "${cfg.package}/theme.css";
    };
  };
}
