# Home Manager module: a theme-only Logseq plugin generated from a palette.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  inherit (lib) mkOption types;

  cfg = config.programs.logseq.themePlugin;
  theme = import ../../lib/logseq-theme.nix { inherit lib; };

  hexColor = types.strMatching "#[0-9a-fA-F]{6}";

  colorOptions =
    defaults: descriptions:
    lib.mapAttrs (
      name: description:
      mkOption {
        type = hexColor;
        default = defaults.${name};
        inherit description;
      }
    ) descriptions;

  toneOptions = lib.mapAttrs (
    _: description:
    mkOption {
      type = types.nullOr hexColor;
      default = null;
      defaultText = lib.literalMD "derived from `accent`, `background`, and `bright`";
      inherit description;
    }
  );

  packageJson = {
    inherit (cfg) name description;
    version = "0.0.1";
    logseq = {
      id = cfg.name;
      inherit (cfg) title;
      themes = [
        {
          name = cfg.title;
          url = "./theme.css";
          inherit (cfg) description;
          mode = "dark";
        }
      ];
    };
  };

  plugin =
    pkgs.runCommand "logseq-theme-plugin-${cfg.name}"
      {
        passAsFile = [
          "css"
          "packageJson"
        ];
        css = theme.render { inherit (cfg) colors extraCss; };
        packageJson = builtins.toJSON packageJson;
        meta = {
          description = "Logseq theme plugin ${cfg.title}";
          platforms = lib.platforms.all;
        };
      }
      ''
        mkdir "$out"
        cp "$cssPath" "$out/theme.css"
        cp "$packageJsonPath" "$out/package.json"
      '';
in
{
  options.programs.logseq.themePlugin = {
    enable = lib.mkEnableOption "a generated dark Logseq theme plugin under ~/.logseq/plugins";

    name = mkOption {
      type = types.strMatching "[A-Za-z0-9][A-Za-z0-9._-]*";
      default = "nix-theme";
      description = ''
        Directory under `~/.logseq/plugins` and the plugin id. Logseq stores
        the selected theme by this id, so renaming it requires selecting the
        theme again in Settings > Themes.
      '';
    };

    title = mkOption {
      type = types.str;
      default = "Nix Theme";
      description = "Theme name shown in Settings > Themes.";
    };

    description = mkOption {
      type = types.str;
      default = "Dark theme generated by Home Manager";
      description = "Plugin and theme description shown in the plugin list.";
    };

    colors = mkOption {
      description = ''
        Semantic palette as `#rrggbb` strings. The twelve neutral steps
        `background` through `text` form Logseq's gray scale in order, from
        the app background to high-contrast text, so a palette that replaces
        them sets all twelve. The defaults are VS Code Dark 2026 greys over
        GitHub Dark syntax colours. The accent tones `highlight`,
        `selection`, `accentStrong`, `link`, and `linkHover` default to
        null: the shipped `accent` over the shipped `background` keeps tuned
        tones, and any other pair blends them from `accent`.
      '';
      default = { };
      type = types.submodule {
        options =
          colorOptions theme.defaultColors {
            background = "Gray step 1: page and editor background.";
            sidebar = "Gray step 2: sidebars and code blocks.";
            popup = "Gray step 3: popovers, menus, property blocks, active code line.";
            border = "Gray step 4: borders and guide lines.";
            activeItem = "Gray step 5: chosen and hovered menu items, scrollbar thumbs.";
            raised = "Gray step 6: raised surfaces and inline code background.";
            strongBorder = "Gray step 7: menu and strong borders.";
            placeholder = "Gray step 8: placeholder text.";
            subtle = "Gray step 9: bullets, checkboxes, quote borders.";
            dim = "Gray step 10: line numbers and low-emphasis text.";
            muted = "Gray step 11: secondary text and icons.";
            text = "Gray step 12: primary text.";
            bright = "Highest-contrast text: selected text, marks, accent step 12.";
            onAccent = "Text on accent-filled buttons.";
            accent = "Accent: focus rings, primary buttons, active items.";
            danger = "Destructive actions.";
            mark = "Highlighted text background, applied at 40% opacity.";
            cloze = "Cloze text.";
          }
          // toneOptions {
            highlight = "Highlighted block background (accent step 3).";
            selection = "Text selection background (accent step 5).";
            accentStrong = "Stronger accent fill (accent step 7).";
            link = "Links, page references, tags (accent steps 10-11).";
            linkHover = "Hovered links and references.";
          }
          // {
            syntax = mkOption {
              description = "CodeMirror code block token colours.";
              default = { };
              type = types.submodule {
                options = colorOptions theme.defaultColors.syntax {
                  keyword = "Keywords and operators.";
                  constant = "Numbers, atoms, properties, attributes.";
                  function = "Definitions.";
                  variable = "Variables.";
                  parameter = "Secondary variables such as parameters.";
                  type = "Types and builtins.";
                  string = "Strings and links.";
                  regexp = "Regular expressions and secondary strings.";
                  comment = "Comments.";
                  tag = "Markup tags.";
                  heading = "Markup headings.";
                  invalid = "Errors and unmatched brackets.";
                };
              };
            };
          };
      };
    };

    extraCss = mkOption {
      type = types.lines;
      default = "";
      description = "CSS appended to the generated theme.css.";
    };

    package = mkOption {
      type = types.package;
      readOnly = true;
      default = plugin;
      defaultText = lib.literalMD "a directory holding the generated `package.json` and `theme.css`";
      description = "The generated plugin directory.";
    };
  };

  config = lib.mkIf cfg.enable {
    # One link per file: Home Manager then creates the plugin folder as a real
    # directory, and Logseq skips symlinked entries when it lists
    # ~/.logseq/plugins (electron/utils.cljs get-ls-default-plugins).
    home.file = {
      ".logseq/plugins/${cfg.name}/package.json".source = "${cfg.package}/package.json";
      ".logseq/plugins/${cfg.name}/theme.css".source = "${cfg.package}/theme.css";
    };
  };
}
